# ============================================
# Application
# ============================================
APP_NAME=API Sentinel
APP_VERSION=0.3.0
DEBUG=false

# ============================================
# Database Configuration
# ============================================
# Local development default (SQLite WAL mode):
DATABASE_URL=sqlite:///./sentinel.db

# Docker Container default (mounted in named volume):
# DATABASE_URL=sqlite:////app/data/sentinel.db

# Production PostgreSQL:
# DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/api_sentinel

# ============================================
# Redis (Optional: if external message broker is enabled)
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# JWT Authentication
# ============================================
# Generate a secret key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# CORS (comma-separated origins)
# ============================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ============================================
# Monitoring Defaults & Engine Configuration
# ============================================
DEFAULT_CHECK_INTERVAL_SECONDS=60
DEFAULT_CHECK_TIMEOUT_SECONDS=30
INCIDENT_THRESHOLD_FAILURES=3
INCIDENT_RECOVERY_THRESHOLD=3
SEED_SAMPLE_USERS=true
